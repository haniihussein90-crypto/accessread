{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zaviqu/qc_report.schema.json",
  "title": "QC Report (Quality-Control Agent output)",
  "description": "Stage 6 output. Studio-level, pre-production QC across the whole campaign — distinct from the Video Editing Agent's own pixel-level quality_check.py, which runs later on rendered exports.",
  "type": "object",
  "required": ["campaign_id", "automated_checks", "overall_automated_pass", "manual_review_required", "approval_status"],
  "properties": {
    "campaign_id": { "type": "string" },
    "automated_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "pass"],
        "properties": {
          "check": { "type": "string" },
          "pass": { "type": "boolean" },
          "details": {}
        }
      }
    },
    "overall_automated_pass": { "type": "boolean" },
    "manual_review_required": { "type": "array", "items": { "type": "string" } },
    "approval_status": {
      "type": "string",
      "enum": ["approved", "blocked_automated_failure", "pending_manual_review"]
    }
  }
}
